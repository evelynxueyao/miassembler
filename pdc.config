process {
    executor = 'slurm'
    queue = 'main'
    clusterOptions = '-A naiss2026-3-773'
}

singularity {
    enabled = true
    autoMounts = true
}

executor {
    queueSize = 100
    submitRateLimit = '10 sec'
}

/*
 * Production array runs launch one independent Nextflow instance
 * per sample. Disable global execution reports so concurrent runs
 * do not write into the same pipeline_info directory.
 *
 * This also disables Nextflow task-metric collection, avoiding
 * the requirement for `ps` inside minimal containers such as
 * python:3.10-slim.
 */
trace {
    enabled = false
}

report {
    enabled = false
}

timeline {
    enabled = false
}

dag {
    enabled = false
}